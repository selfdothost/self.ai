# self.ai — example environment
#
# Copy to `.env` and fill in. Every value here is a placeholder. Never commit
# a real `.env`. See docs/config-reference.md for the full reference.
#
# The ONLY value you must set to boot with auth on is WEBUI_SECRET_KEY — the
# app refuses to start on the well-known default.

# --- Required ---------------------------------------------------------------
# A long random string. Generate one, e.g.: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# --- Public URL -------------------------------------------------------------
# The externally reachable base URL of your deployment.
WEBUI_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Default is local SQLite (no value needed). For Postgres, set a DSN:
# DATABASE_URL=postgresql://dbuser:dbpassword@db-host:5432/selfai

# --- Knowledge base (RAG) ---------------------------------------------------
# Vector store defaults to sqlite-vec (local, a single file under the data
# dir) — no extra service, which is why the combined image works out of the
# box. To use pgvector instead (needs Postgres with the vector extension):
# VECTOR_DB=pgvector
# PGVECTOR_DB_URL=postgresql://dbuser:dbpassword@db-host:5432/selfai
#
# Embeddings: the default image is API-only (no bundled embedding model), so the
# knowledge base needs an OpenAI-compatible embeddings endpoint. Point it at the
# same provider you use for chat (or any embeddings server). Without this,
# uploading or querying a knowledge base returns a clear "no embedding backend"
# error. (To embed locally instead, run the full image and leave these unset.)
# RAG_EMBEDDING_ENGINE=openai
# RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=sk-your-key
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Web loader / crawl (optional) ------------------------------------------
# Fetches page content for web-search results and "crawl a site into a KB".
# Firecrawl engine — point at any Firecrawl-compatible endpoint (e.g. a
# self-hosted crawler). Crawled pages are embedded, so an embeddings endpoint
# (above) must also be configured.
# RAG_WEB_LOADER_ENGINE=firecrawl
# FIRECRAWL_API_BASE_URL=http://firecrawl:3002
# FIRECRAWL_API_KEY=
# Web *search* still needs a search engine set separately, e.g.:
# RAG_WEB_SEARCH_ENGINE=searxng

# --- Inference providers (all optional; empty = disabled) -------------------
# OpenAI-compatible API:
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key
# Local model-serving endpoints (comma-separated for multiple):
# OLLAMA_BASE_URL=http://ollama:11434
# LLAMOLOTL_BASE_URLS=http://llamolotl:8080

# --- Auth / OIDC (optional; leave blank to disable) -------------------------
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_PROVIDER_URL=https://auth.example.com/realms/your-realm/.well-known/openid-configuration
# OPENID_REDIRECT_URI=

# --- Object storage (optional; default is local disk) -----------------------
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION_NAME=

# --- Speech (optional; fall back to OPENAI_API_* if unset) ------------------
# In the yard's Flux deploy (manifests/), self.transcribe is reachable
# in-cluster at self-transcribe:8890 (manifests/audio/transcribe.yaml)
# — set AUDIO_STT_ENGINE=openai too, or this URL is never used (see
# manifests/api/10-deployment.yaml). self.speak is reachable in-cluster at
# self-speak:8880 (manifests/audio/speak.yaml) — set AUDIO_TTS_ENGINE=openai
# too, or the TTS URL below is never used either.
# AUDIO_STT_ENGINE=openai
# AUDIO_STT_OPENAI_API_BASE_URL=http://self-transcribe:8890/v1
# AUDIO_TTS_ENGINE=openai
# AUDIO_TTS_OPENAI_API_BASE_URL=http://self-speak:8880/v1

# --- Misc -------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# CORS_ALLOW_ORIGIN=      # leave empty; "*" is NOT recommended
